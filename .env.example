# 本地敏感配置模板。
# 复制为 .env 后填写真实 key；.env 会被 git 忽略。
# 非敏感 benchmark 参数请修改 sts2_bench/benchmark.yaml。

# DeepSeek API key。使用 DeepSeek 时填写这一项。
DEEPSEEK_API_KEY=

# OpenAI 或其他兼容服务的 API key。通常不需要；当未设置 DEEPSEEK_API_KEY 时会作为 fallback。
# OPENAI_API_KEY=

# APiHY relay example. Keep real keys in .env only.
# STS2_BENCH_BASE_URL=https://zgc.apihy.com/v1
# STS2_BENCH_MODEL=deepseek-v4-pro
# APIHY_DEEPSEEK_API_KEY=
# APIHY_OPENAI_API_KEY=
